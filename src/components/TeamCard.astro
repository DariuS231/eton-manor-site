---
import { netlifyImage } from '../lib/netlifyImage';

interface Props {
  name: string;
  role: string;
  photo?: string;
  photoFocalPoint?: 'top' | 'center' | 'bottom' | null;
}

const { name, role, photo, photoFocalPoint } = Astro.props;
const resolvedFocalPoint = photoFocalPoint ?? 'center';

const words = name.trim().split(/\s+/);
const initials =
  words.length > 1
    ? `${words[0][0]}${words[words.length - 1][0]}`
    : words[0].slice(0, 2);

const focalPointClass = {
  top: 'object-top',
  center: 'object-center',
  bottom: 'object-bottom',
}[resolvedFocalPoint];
---
<div
  class="rounded-xl bg-paper p-6 text-center shadow-card transition-all duration-200 hover:-translate-y-1 hover:shadow-card-hover"
>
  {photo ? (
    <img
      src={netlifyImage(photo, { width: 256, height: 256, position: resolvedFocalPoint })}
      alt={name}
      loading="lazy"
      decoding="async"
      width="256"
      height="256"
      class:list={['mx-auto mb-4 h-32 w-32 rounded-full object-cover', focalPointClass]}
    />
  ) : (
    <div class="mx-auto mb-4 flex h-32 w-32 items-center justify-center rounded-full bg-powder">
      <span class="font-heading text-3xl uppercase text-ink">
        {initials}
      </span>
    </div>
  )}
  <h3 class="text-2xl uppercase tracking-wide">{name}</h3>
  <p class="mt-1 text-sm uppercase tracking-wide text-navy">{role}</p>
  <div class="prose mt-3 text-left text-sm">
    <slot />
  </div>
</div>
