---
import { formatDate } from '../lib/formatDate';

interface Props {
  title: string;
  date: Date;
  time?: string;
  location: string;
  eventType: string;
  href: string;
}

const { title, date, time, location, eventType, href } = Astro.props;
const formattedDate = formatDate(date);
---
<a
  href={href}
  class="block rounded-xl bg-paper p-4 shadow-card transition-all duration-200 hover:-translate-y-1 hover:shadow-card-hover"
>
  <span class="text-xs font-semibold uppercase tracking-wide text-navy">{eventType}</span>
  <h3 class="font-heading text-xl">{title}</h3>
  <p class="mt-1 text-sm">{formattedDate}{time ? ` · ${time}` : ''}</p>
  <p class="text-sm">{location}</p>
</a>
