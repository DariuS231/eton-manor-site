---
import settings from '../data/settings.json';

interface NavChild {
  label: string;
  url: string;
}

interface NavLink {
  label: string;
  url?: string;
  children?: NavChild[];
}

const navLinks = settings.navLinks as NavLink[];
---
<header class="sticky top-0 z-50 bg-navy/95 text-paper backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="font-[family-name:--font-heading] text-xl sm:text-2xl font-semibold uppercase tracking-wide">
      {settings.logo ? (
        <img src={settings.logo} alt={settings.siteTitle} class="h-8 sm:h-10 w-auto" />
      ) : (
        <span>{settings.siteTitle}</span>
      )}
    </a>

    <div class="flex items-center gap-1">
      <nav class="hidden sm:block">
      <ul class="flex gap-1 sm:gap-2 font-[family-name:--font-body] text-sm uppercase tracking-wide">
        {navLinks.map((link, i) => (
          <li class="relative">
            {link.children && link.children.length > 0 ? (
              <div class="flex items-center">
                {link.url ? (
                  <a
                    href={link.url}
                    class="block rounded-full py-1.5 pl-3 pr-1 transition-colors duration-200 hover:bg-powder/20 hover:text-powder"
                  >
                    {link.label}
                  </a>
                ) : (
                  <span class="block rounded-full py-1.5 pl-3 pr-1">{link.label}</span>
                )}
                <button
                  type="button"
                  aria-expanded="false"
                  aria-controls={`desktop-dropdown-${i}`}
                  aria-label={`${link.label} submenu`}
                  class="dropdown-toggle rounded-full p-1.5 transition-colors duration-200 hover:bg-powder/20 hover:text-powder"
                >
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
                  </svg>
                </button>
                <ul
                  id={`desktop-dropdown-${i}`}
                  class="dropdown-panel absolute left-0 top-full z-10 mt-1 hidden min-w-[10rem] rounded-xl bg-navy py-2 shadow-card-hover"
                >
                  {link.children.map((child) => (
                    <li>
                      <a
                        href={child.url}
                        class="block px-4 py-2 transition-colors duration-200 hover:bg-powder/20 hover:text-powder"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <a
                href={link.url}
                class="block rounded-full px-3 py-1.5 transition-colors duration-200 hover:bg-powder/20 hover:text-powder"
              >
                {link.label}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <a
      href="/club-kit/cart"
      class="relative inline-flex h-10 w-10 items-center justify-center rounded-full transition-colors duration-200 hover:bg-powder/20"
      aria-label="View cart"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 1.994-4.693 2.615-7.151.16-.633-.32-1.249-.972-1.249H4.756m3.132 8.4l-.94-3.526M6.75 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
      </svg>
      <span
        id="cart-count"
        class="absolute -right-0.5 -top-0.5 hidden h-5 w-5 items-center justify-center rounded-full bg-powder text-xs font-semibold text-ink"
      >
        0
      </span>
    </a>

    <button
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full transition-colors duration-200 hover:bg-powder/20 sm:hidden"
    >
      <span class="sr-only">Toggle navigation</span>
      <svg id="nav-icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="nav-icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden sm:hidden">
    <ul class="flex flex-col gap-1 px-6 pb-4 font-[family-name:--font-body] text-sm uppercase tracking-wide">
      {navLinks.map((link, i) => (
        <li>
          {link.children && link.children.length > 0 ? (
            <>
              <div class="flex items-center justify-between">
                {link.url ? (
                  <a
                    href={link.url}
                    class="block flex-1 rounded-full px-3 py-2 transition-colors duration-200 hover:bg-powder/20 hover:text-powder"
                  >
                    {link.label}
                  </a>
                ) : (
                  <span class="block flex-1 px-3 py-2">{link.label}</span>
                )}
                <button
                  type="button"
                  aria-expanded="false"
                  aria-controls={`mobile-dropdown-${i}`}
                  aria-label={`${link.label} submenu`}
                  class="dropdown-toggle rounded-full p-2 transition-colors duration-200 hover:bg-powder/20 hover:text-powder"
                >
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" />
                  </svg>
                </button>
              </div>
              <div id={`mobile-dropdown-${i}`} class="dropdown-panel hidden">
                <ul class="flex flex-col gap-1 py-1 pl-6">
                  {link.children.map((child) => (
                    <li>
                      <a
                        href={child.url}
                        class="block rounded-full px-3 py-2 transition-colors duration-200 hover:bg-powder/20 hover:text-powder"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </>
          ) : (
            <a
              href={link.url}
              class="block rounded-full px-3 py-2 transition-colors duration-200 hover:bg-powder/20 hover:text-powder"
            >
              {link.label}
            </a>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  import { getCartCount } from '../lib/cart.js';

  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    panel?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  function panelFor(btn: Element): HTMLElement | null {
    const id = btn.getAttribute('aria-controls');
    return id ? document.getElementById(id) : null;
  }

  function closeAllDropdowns(except?: Element) {
    document.querySelectorAll('.dropdown-toggle[aria-expanded="true"]').forEach((btn) => {
      if (btn === except) return;
      btn.setAttribute('aria-expanded', 'false');
      panelFor(btn)?.classList.add('hidden');
    });
  }

  document.querySelectorAll('.dropdown-toggle').forEach((btn) => {
    btn.addEventListener('click', (event) => {
      event.stopPropagation();
      const dropdownPanel = panelFor(btn);
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      closeAllDropdowns(btn);
      btn.setAttribute('aria-expanded', String(!isOpen));
      dropdownPanel?.classList.toggle('hidden');
    });
  });

  document.addEventListener('click', () => closeAllDropdowns());

  function updateCartBadge() {
    const badge = document.getElementById('cart-count');
    if (!badge) return;
    const count = getCartCount();
    badge.textContent = String(count);
    badge.classList.toggle('hidden', count === 0);
    badge.classList.toggle('flex', count > 0);
  }

  updateCartBadge();
  document.addEventListener('cart:change', updateCartBadge);
</script>
