---
import { parseStravaUrl } from '../lib/strava';

interface Props {
  url: string;
}

const { url } = Astro.props;
const embed = parseStravaUrl(url);
---
{embed && (
  <div>
    <div
      class="strava-embed-placeholder"
      data-embed-type={embed.type}
      data-embed-id={embed.id}
      data-style="standard"
      data-from-embed="false"
    ></div>
    <script is:inline src="https://strava-embeds.com/embed.js"></script>
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-3 inline-block text-sm font-semibold uppercase tracking-wide text-navy hover:underline"
    >
      View on Strava
    </a>
  </div>
)}
