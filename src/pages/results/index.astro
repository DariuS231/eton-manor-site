---
import { marked } from 'marked';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import resultsPage from '../../data/results.json';
import { netlifyImage } from '../../lib/netlifyImage';

const contentHtml = resultsPage.content ? await marked.parse(resultsPage.content) : '';

const results = await getCollection('results');
---
<BaseLayout title={`${resultsPage.title} — Eton Manor Running Club`} image={resultsPage.heroImage}>
  {resultsPage.heroImage && (
    <div class="relative h-[50vh] min-h-[320px] w-full overflow-hidden">
      <img
        src={netlifyImage(resultsPage.heroImage, { width: 1600, height: 900 })}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-black/40"></div>
      <div class="relative z-10 flex h-full items-center justify-center px-6 text-center">
        <h1 class="text-4xl uppercase tracking-wide text-paper">{resultsPage.title}</h1>
      </div>
    </div>
  )}
  <section class="mx-auto max-w-3xl px-6 py-16">
    {!resultsPage.heroImage && (
      <h1 class="mb-6 text-4xl uppercase tracking-wide">{resultsPage.title}</h1>
    )}
    {contentHtml && <div class="prose mb-8" set:html={contentHtml} />}

    <ul class="flex flex-col gap-4">
      {results.map((entry) => (
        <li>
          <a
            href={`/results/${entry.id}`}
            class="block rounded-xl bg-paper p-4 shadow-card transition-all duration-200 hover:-translate-y-1 hover:shadow-card-hover"
          >
            <h2 class="font-heading text-xl">{entry.data.title}</h2>
            {entry.data.description && <p class="mt-1 text-sm">{entry.data.description}</p>}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
