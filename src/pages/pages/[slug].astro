---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';

export async function getStaticPaths() {
  const pages = await getCollection('contentPages');
  return pages.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const focalPointClass = {
  top: 'object-top',
  center: 'object-center',
  bottom: 'object-bottom',
}[entry.data.heroImageFocalPoint ?? 'center'];
---
<BaseLayout title={`${entry.data.title} — Eton Manor Running Club`}>
  {entry.data.heroImage && (
    <div class="relative h-[50vh] min-h-[320px] w-full overflow-hidden">
      <img
        src={entry.data.heroImage}
        alt=""
        class:list={['absolute inset-0 h-full w-full object-cover', focalPointClass]}
      />
      <div class="absolute inset-0 bg-black/40"></div>
      <div class="relative z-10 flex h-full items-center justify-center px-6 text-center">
        <h1 class="text-4xl uppercase tracking-wide text-paper">{entry.data.title}</h1>
      </div>
    </div>
  )}
  <article class="mx-auto max-w-3xl px-6 py-16">
    {!entry.data.heroImage && (
      <h1 class="mb-6 text-4xl uppercase tracking-wide">{entry.data.title}</h1>
    )}
    <div class="prose">
      <Content />
    </div>
    {entry.data.gallery && entry.data.gallery.length > 0 && (
      <div class="mt-8">
        <h2 class="mb-4 text-2xl uppercase tracking-wide">Gallery</h2>
        <Gallery images={entry.data.gallery} />
      </div>
    )}
  </article>
</BaseLayout>
