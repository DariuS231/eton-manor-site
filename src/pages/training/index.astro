---
import { marked } from 'marked';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrainingSessionCard from '../../components/TrainingSessionCard.astro';
import trainingPage from '../../data/training.json';
import { netlifyImage } from '../../lib/netlifyImage';

const contentHtml = trainingPage.content ? await marked.parse(trainingPage.content) : '';

const sessions = (await getCollection('trainingSessions')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---
<BaseLayout title={`${trainingPage.title} — Eton Manor Running Club`} image={trainingPage.heroImage}>
  {trainingPage.heroImage && (
    <div class="relative h-[50vh] min-h-[320px] w-full overflow-hidden">
      <img
        src={netlifyImage(trainingPage.heroImage, { width: 1600, height: 900 })}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-black/40"></div>
      <div class="relative z-10 flex h-full items-center justify-center px-6 text-center">
        <h1 class="text-4xl uppercase tracking-wide text-paper">{trainingPage.title}</h1>
      </div>
    </div>
  )}
  <section class="mx-auto max-w-5xl px-6 py-16">
    {!trainingPage.heroImage && (
      <h1 class="mb-6 text-4xl uppercase tracking-wide">{trainingPage.title}</h1>
    )}
    {contentHtml && <div class="prose mb-8" set:html={contentHtml} />}

    <div class="grid gap-6 sm:grid-cols-3">
      {sessions.map((session) => (
        <TrainingSessionCard
          title={session.data.title}
          sessionType={session.data.sessionType}
          heroImage={session.data.heroImage}
          heroImageFocalPoint={session.data.heroImageFocalPoint}
          href={`/training/${session.id}`}
        />
      ))}
    </div>
  </section>
</BaseLayout>
