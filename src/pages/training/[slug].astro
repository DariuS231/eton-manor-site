---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StravaEmbed from '../../components/StravaEmbed.astro';
import { netlifyImage } from '../../lib/netlifyImage';

export async function getStaticPaths() {
  const sessions = await getCollection('trainingSessions');
  return sessions.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const focalPointClass = {
  top: 'object-top',
  center: 'object-center',
  bottom: 'object-bottom',
}[entry.data.heroImageFocalPoint ?? 'center'];
---
<BaseLayout
  title={`${entry.data.title} — Eton Manor Running Club`}
  description={`${entry.data.sessionType} training session: ${entry.data.title}.`}
  image={entry.data.heroImage}
>
  {entry.data.heroImage && (
    <div class="relative h-[50vh] min-h-[320px] w-full overflow-hidden">
      <img
        src={netlifyImage(entry.data.heroImage, { width: 1600, height: 900 })}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class:list={['absolute inset-0 h-full w-full object-cover', focalPointClass]}
      />
      <div class="absolute inset-0 bg-black/40"></div>
      <div class="relative z-10 flex h-full items-center justify-center px-6 text-center">
        <h1 class="text-4xl uppercase tracking-wide text-paper">{entry.data.title}</h1>
      </div>
    </div>
  )}
  <article class="mx-auto max-w-3xl px-6 py-16">
    <span class="text-xs font-semibold uppercase tracking-wide text-navy">{entry.data.sessionType}</span>
    {!entry.data.heroImage && (
      <h1 class="mb-6 text-4xl uppercase tracking-wide">{entry.data.title}</h1>
    )}
    <div class="prose mb-8 mt-4 text-justify">
      <Content />
    </div>
    <StravaEmbed url={entry.data.stravaUrl} />
  </article>
</BaseLayout>
