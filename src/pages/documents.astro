---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const documents = await getCollection('documents');
---
<BaseLayout title="Documents — Eton Manor Running Club">
  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="mb-8 text-4xl uppercase tracking-wide">Documents</h1>
    <ul class="flex flex-col gap-4">
      {documents.map((doc) => (
        <li class="rounded-xl bg-paper p-4 shadow-card transition-all duration-200 hover:-translate-y-1 hover:shadow-card-hover">
          <a
            href={doc.data.file}
            target="_blank"
            rel="noopener noreferrer"
            class="font-[family-name:--font-heading] text-xl"
          >
            {doc.data.title}
          </a>
          {doc.data.description && <p class="mt-1 text-sm">{doc.data.description}</p>}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
