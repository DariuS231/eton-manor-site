---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import home from '../data/home.json';

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const now = new Date();
now.setHours(0, 0, 0, 0);
const events = (await getCollection('events'))
  .filter((e) => e.data.date >= now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 3);

const heroImages: string[] = (home as { heroImages?: string[] }).heroImages ?? [];
const showSeconds = 5;
const fadeSeconds = 1;
const cycleSeconds = heroImages.length * showSeconds;

function heroFadeKeyframes(index: number, count: number): string {
  const start = ((index * showSeconds) / (count * showSeconds)) * 100;
  const end = (((index + 1) * showSeconds) / (count * showSeconds)) * 100;
  const fadePct = (fadeSeconds / (count * showSeconds)) * 100;
  const fadeInStart = Math.max(0, start - fadePct);
  const holdEnd = Math.max(start, end - fadePct);
  return `@keyframes hero-fade-${index} {
    0% { opacity: 0; }
    ${fadeInStart.toFixed(3)}% { opacity: 0; }
    ${start.toFixed(3)}% { opacity: 1; }
    ${holdEnd.toFixed(3)}% { opacity: 1; }
    ${end.toFixed(3)}% { opacity: 0; }
    100% { opacity: 0; }
  }`;
}

const heroKeyframesCss = heroImages
  .map((_, i) => heroFadeKeyframes(i, heroImages.length))
  .join('\n');
---
<BaseLayout title={`${home.heroHeading} — Eton Manor Running Club`}>
  <section class="relative overflow-hidden bg-navy text-paper px-6 py-20 text-center">
    {heroImages.length > 0 && (
      <>
        {heroImages.map((src, i) => (
          <img
            src={src}
            alt=""
            class="absolute inset-0 h-full w-full object-cover"
            style={
              heroImages.length > 1
                ? `animation: hero-fade-${i} ${cycleSeconds}s infinite;`
                : 'opacity: 1;'
            }
          />
        ))}
        <div class="absolute inset-0 bg-black/40"></div>
      </>
    )}
    <div class="relative z-10">
      <h1 class="text-5xl font-semibold uppercase tracking-wide">{home.heroHeading}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg">{home.heroSubheading}</p>
      <a
        href={home.heroCtaUrl}
        class="mt-8 inline-block rounded-full bg-powder px-6 py-3 font-semibold uppercase tracking-wide text-ink transition-all duration-200 hover:-translate-y-0.5 hover:bg-white hover:shadow-card-hover"
      >
        {home.heroCtaLabel}
      </a>
    </div>
  </section>

  {heroImages.length > 1 && <style set:html={heroKeyframesCss} />}

  <section class="mx-auto max-w-3xl px-6 py-12 text-center">
    <p>{home.introBody}</p>
  </section>

  <section class="bg-navy/5 px-6 py-12">
    <div class="mx-auto max-w-5xl">
      <h2 class="mb-6 text-3xl uppercase tracking-wide">Latest News</h2>
      <ul class="grid gap-6 sm:grid-cols-3">
        {news.map((post) => (
          <li class="rounded-xl bg-paper p-4 shadow-card transition-all duration-200 hover:-translate-y-1 hover:shadow-card-hover">
            <a href={`/news/${post.id}`} class="font-[family-name:--font-heading] text-xl">{post.data.title}</a>
            <p class="mt-2 text-sm">{post.data.excerpt}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-12">
    <h2 class="mb-6 text-3xl uppercase tracking-wide">Upcoming Events</h2>
    <ul class="grid gap-6 sm:grid-cols-3">
      {events.map((event) => (
        <li class="rounded-xl bg-paper p-4 shadow-card transition-all duration-200 hover:-translate-y-1 hover:shadow-card-hover">
          <a href={`/events/${event.id}`} class="font-[family-name:--font-heading] text-xl">{event.data.title}</a>
          <p class="mt-2 text-sm">{event.data.location}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
